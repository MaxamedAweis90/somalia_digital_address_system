generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String        @id @default(cuid())
  name                    String
  email                   String        @unique
  emailVerified           Boolean       @default(false)
  image                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  password                String
  role                    UserRole      @default(DATA_OFFICER)
  supervisorId            String?       @map("supervisor_id")
  assignments_assigned_by assignments[] @relation("assignments_assigned_by_idTouser")
  assignments_assigned_to assignments[] @relation("assignments_assigned_to_idTouser")
  assignments_reviewed_by assignments[] @relation("assignments_reviewed_by_idTouser")
  auditLogs               AuditLog[]
  loginOtps               LoginOtp[]


  @@map("user")
}

model LoginOtp {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumed], map: "login_otp_user_consumed_index")
  @@map("login_otps")
}
model Region {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  status    Status     @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  districts District[]

  @@index([code], map: "region_code_index")
  @@map("regions")
}

model District {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  status        Status         @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  regionId      String         @map("region_id")
  addresses     Address[]
  region        Region         @relation(fields: [regionId], references: [id])
  neighborhoods Neighborhood[]

  @@index([code], map: "district_code_index")
  @@index([regionId], map: "district_region_index")
  @@map("districts")
}

model Neighborhood {
  id          String        @id @default(cuid())
  districtId  String        @map("district_id")
  name        String
  code        String        @unique
  status      Status        @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  addresses   Address[]
  assignments assignments[]
  district    District      @relation(fields: [districtId], references: [id])
  zones       Zone[]

  @@index([code, districtId], map: "neighborhood_code_and_district_index")
  @@map("neighborhoods")
}

model Zone {
  id             String                  @id @default(cuid())
  neighborhoodId String                  @map("neighborhood_id")
  name           String
  code           String                  @unique
  status         Status                  @default(ACTIVE)
  geometry       Unsupported("geometry")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  addresses      Address[]
  neighborhood   Neighborhood            @relation(fields: [neighborhoodId], references: [id])

  @@index([code, neighborhoodId], map: "zone_code_and_neighborhood_index")
  @@map("zones")
}

model Address {
  id             String       @id @default(cuid())
  addressCode    String       @unique @map("address_code")
  districtId     String       @map("district_id")
  neighborhoodId String       @map("neighborhood_id")
  zoneId         String       @map("zone_id")
  houseNumber    BigInt       @map("house_number")
  streetName     String       @map("street_name")
  description    String
  status         Status       @default(ACTIVE)
  location       String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  district       District     @relation(fields: [districtId], references: [id])
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  zone           Zone         @relation(fields: [zoneId], references: [id])

  @@index([addressCode, districtId, neighborhoodId, zoneId], map: "address_code_and_location_index")
  @@map("addresses")
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  action     String
  actionType ActionType @map("action_type")
  entityId   String     @map("entity_id")
  timestamp  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model app_settings {
  id          String      @id
  key         String      @unique
  label       String
  value       String
  description String?
  category    String      @default("general")
  type        SettingType @default(STRING)
  is_system   Boolean     @default(false)
  created_at  DateTime    @default(now())
  updated_at  DateTime

  @@index([category], map: "app_setting_category_index")
}

model assignments {
  id                     String           @id @default(cuid())
  type                   AssignmentType   @default(DEFINE_ZONES)
  status                 AssignmentStatus @default(ASSIGNED)
  neighborhoodId         String           @map("neighborhood_id")
  assignedToId           String           @map("assigned_to_id")
  assignedById           String           @map("assigned_by_id")
  expectedCollectorCount Int?             @map("expected_collector_count")
  parentId               String?          @map("parent_id")
  payload                Json             @default("{\"zones\": []}")
  notes                  String?
  dueAt                  DateTime?        @map("due_at")
  submittedAt            DateTime?        @map("submitted_at")
  reviewedAt             DateTime?        @map("reviewed_at")
  reviewedById           String?          @map("reviewed_by_id")
  rejectionReason        String?          @map("rejection_reason")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  assignedBy             User             @relation("assignments_assigned_by_idTouser", fields: [assignedById], references: [id])
  assignedTo             User             @relation("assignments_assigned_to_idTouser", fields: [assignedToId], references: [id])
  neighborhood           Neighborhood     @relation(fields: [neighborhoodId], references: [id])
  reviewedBy             User?            @relation("assignments_reviewed_by_idTouser", fields: [reviewedById], references: [id])
  parent                 assignments?     @relation("AssignmentHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children               assignments[]    @relation("AssignmentHierarchy")

  @@index([assignedToId, status], map: "assignment_assignee_status_index")
  @@index([neighborhoodId], map: "assignment_neighborhood_index")
  @@index([parentId], map: "assignment_parent_index")
}

enum UserRole {
  SYS_ADMIN
  DATA_OFFICER
  DATA_COLLECTOR
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  READY_FOR_REVIEW
  SUBMITTED
  APPROVED
  REJECTED
}

enum AssignmentType {
  DEFINE_ZONES
  DEFINE_ZONE_BLOCKS
  REGISTER_ADDRESSES
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}
