generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String
  role          UserRole   @default(DATA_OFFICER)
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  auditLogs     AuditLog[]
  assignmentsAssigned Assignment[] @relation("AssignmentAssignee")
  assignmentsCreated  Assignment[] @relation("AssignmentCreator")
  assignmentsReviewed Assignment[] @relation("AssignmentReviewer")

  @@map("user")
}

model Region {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  status    Status     @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  districts District[]

  @@index([code], map: "region_code_index")
  @@map("regions")
}

model District {
  id            String         @id @default(cuid())
  regionId      String         @map("region_id")
  name          String
  code          String         @unique
  status        Status         @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  addresses     Address[]
  neighborhoods Neighborhood[]
  region        Region         @relation(fields: [regionId], references: [id])

  @@index([code], map: "district_code_index")
  @@index([regionId], map: "district_region_index")
  @@map("districts")
}

model Neighborhood {
  id         String                  @id @default(cuid())
  districtId String                  @map("district_id")
  name       String
  code       String                  @unique
  status     Status                  @default(ACTIVE)
  geometry   Unsupported("geometry")?
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  addresses  Address[]
  district   District                @relation(fields: [districtId], references: [id])
  zones      Zone[]
  assignments Assignment[]

  @@index([code, districtId], map: "neighborhood_code_and_district_index")
  @@map("neighborhoods")
}

model Zone {
  id             String                  @id @default(cuid())
  neighborhoodId String                  @map("neighborhood_id")
  name           String
  code           String                  @unique
  status         Status                  @default(ACTIVE)
  geometry       Unsupported("geometry")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  addresses      Address[]
  neighborhood   Neighborhood            @relation(fields: [neighborhoodId], references: [id])
  assignments    Assignment[]

  @@index([code, neighborhoodId], map: "zone_code_and_neighborhood_index")
  @@map("zones")
}

model Address {
  id             String       @id @default(cuid())
  addressCode    String       @unique @map("address_code")
  districtId     String       @map("district_id")
  neighborhoodId String       @map("neighborhood_id")
  zoneId         String       @map("zone_id")
  houseNumber    BigInt       @map("house_number")
  streetName     String       @map("street_name")
  description    String
  status         Status       @default(ACTIVE)
  location       String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  district       District     @relation(fields: [districtId], references: [id])
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  zone           Zone         @relation(fields: [zoneId], references: [id])

  @@index([addressCode, districtId, neighborhoodId, zoneId], map: "address_code_and_location_index")
  @@map("addresses")
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  action     String
  actionType ActionType @map("action_type")
  entityId   String     @map("entity_id")
  timestamp  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  SYS_ADMIN
  DATA_OFFICER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model AppSetting {
  id          String      @id @default(cuid())
  key         String      @unique
  label       String
  value       String
  description String?
  category    String      @default("general")
  type        SettingType @default(STRING)
  isSystem    Boolean     @default(false) @map("is_system")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([category], map: "app_setting_category_index")
  @@map("app_settings")
}

enum AssignmentType {
  DEFINE_ZONES
  REGISTER_ADDRESSES
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

model Assignment {
  id              String           @id @default(cuid())
  type            AssignmentType   @default(DEFINE_ZONES)
  status          AssignmentStatus @default(ASSIGNED)
  neighborhoodId  String           @map("neighborhood_id")
  zoneId          String?          @map("zone_id")
  assignedToId    String           @map("assigned_to_id")
  assignedById    String           @map("assigned_by_id")
  payload         Json             @default("{\"zones\":[]}")
  notes           String?
  dueAt           DateTime?        @map("due_at")
  submittedAt     DateTime?        @map("submitted_at")
  reviewedAt      DateTime?        @map("reviewed_at")
  reviewedById    String?          @map("reviewed_by_id")
  rejectionReason String?          @map("rejection_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  neighborhood    Neighborhood     @relation(fields: [neighborhoodId], references: [id])
  zone            Zone?            @relation(fields: [zoneId], references: [id])
  assignedTo      User             @relation("AssignmentAssignee", fields: [assignedToId], references: [id])
  assignedBy      User             @relation("AssignmentCreator", fields: [assignedById], references: [id])
  reviewedBy      User?            @relation("AssignmentReviewer", fields: [reviewedById], references: [id])

  @@index([assignedToId, status], map: "assignment_assignee_status_index")
  @@index([neighborhoodId], map: "assignment_neighborhood_index")
  @@index([zoneId], map: "assignment_zone_index")
  @@map("assignments")
}
