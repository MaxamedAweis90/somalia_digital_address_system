generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String     // <-- Halkan ku dar
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  account       Account[]
  auditLogs     AuditLog[]
  session       Session[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@map("verification")
}

model District {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  status        Status         @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  addresses     Address[]
  neighborhoods Neighborhood[]

  @@index([code], map: "district_code_index")
  @@map("districts")
}

model Neighborhood {
  id         String    @id @default(cuid())
  districtId String    @map("district_id")
  name       String
  code       String    @unique
  status     Status    @default(ACTIVE)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  addresses  Address[]
  district   District  @relation(fields: [districtId], references: [id])
  zones      Zone[]

  @@index([code, districtId], map: "neighborhood_code_and_district_index")
  @@map("neighborhoods")
}

model Zone {
  id             String                  @id @default(cuid())
  neighborhoodId String                  @map("neighborhood_id")
  name           String
  code           String                  @unique
  status         Status                  @default(ACTIVE)
  geometry       Unsupported("geometry")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  addresses      Address[]
  neighborhood   Neighborhood            @relation(fields: [neighborhoodId], references: [id])

  @@index([code, neighborhoodId], map: "zone_code_and_neighborhood_index")
  @@map("zones")
}

model Address {
  id             String       @id @default(cuid())
  addressCode    String       @unique @map("address_code")
  districtId     String       @map("district_id")
  neighborhoodId String       @map("neighborhood_id")
  zoneId         String       @map("zone_id")
  houseNumber    BigInt       @map("house_number")
  streetName     String       @map("street_name")
  description    String
  status         Status       @default(ACTIVE)
  location       String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  district       District     @relation(fields: [districtId], references: [id])
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  zone           Zone         @relation(fields: [zoneId], references: [id])

  @@index([addressCode, districtId, neighborhoodId, zoneId], map: "address_code_and_location_index")
  @@map("addresses")
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  action     String
  actionType ActionType @map("action_type")
  entityId   String     @map("entity_id")
  timestamp  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  SYS_ADMIN
  DATA_OFFICER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
}
